library(tidyverse)
library(rstatix) # for statistical testing
library(DT) # for results display
library(ggpubr) # for normality testing QQ plot panel
library(factoextra)
library(ggforce)
library(janitor)  # For cleaning names
library(RColorBrewer)
library(openxlsx)
library(caret)
library(ggcorrplot)
library(gridExtra)
dat_all <- read.xlsx("../1_InputData/Processed Data/Processed_Data_020226.xlsx")
View(dat_all)
View(dat_all)
dat_all <- read.xlsx("../1_InputData/Processed Data/Processed_Data_020226.xlsx")
# Separate by weight vs. volume
data_vol <- dat_all %>%
filter(Metric == "Volume") %>%
mutate(Unique_ID = paste0(HAWC_ID, '_', Sample_Number)) %>%
mutate(Value = log2(Value + 1))
data_wt <- dat_all %>%
filter(Metric == "Weight") %>%
mutate(Unique_ID = paste0(HAWC_ID, '_', Sample_Number)) %>%
mutate(Value = log2(Value + 1))
View(data_vol)
# VOLUME
shapiro_res_vol <- data_vol %>%
group_by(DTXSID) %>%
shapiro_test(Value) %>%
mutate(normal = ifelse(p < 0.05, F, T))
table(shapiro_res_vol$normal)
datatable(shapiro_res_vol)
# WEIGHT
shapiro_res_wt <- data_wt %>%
group_by(DTXSID) %>%
shapiro_test(Value) %>%
mutate(normal = ifelse(p < 0.05, F, T))
table(shapiro_res_wt$normal)
datatable(shapiro_res_wt)
# Create an empty list to store the plots
plot_list <- list()
# Loop over data_vol
unique_names_vol <- unique(data_vol$Name)
for(nm in unique_names_vol) {
subset_data <- subset(data_vol, Name == nm)
# Calculate an appropriate binwidth for around 30 bins
range_val <- max(subset_data$Value, na.rm = TRUE) - min(subset_data$Value, na.rm = TRUE)
binwidth <- range_val / 30
p <- ggplot(subset_data, aes(x = Value)) +
geom_histogram(binwidth = binwidth, fill = "blue", color = "black") +
ggtitle(paste("data_vol -", nm)) +
theme_minimal()
plot_list[[length(plot_list) + 1]] <- p
}
# Loop over data_wt
unique_names_wt <- unique(data_wt$Name)
for(nm in unique_names_wt) {
subset_data <- subset(data_wt, Name == nm)
range_val <- max(subset_data$Value, na.rm = TRUE) - min(subset_data$Value, na.rm = TRUE)
binwidth <- range_val / 30
p <- ggplot(subset_data, aes(x = Value)) +
geom_histogram(binwidth = binwidth, fill = "red", color = "black") +
ggtitle(paste("data_wt -", nm)) +
theme_minimal()
plot_list[[length(plot_list) + 1]] <- p
}
# Save the arranged plots to a PDF
pdf(file = '../3_OutputFigs/Chemical_histograms_norm.pdf', width = 14, height = 6)
plots <- ggarrange(plotlist = plot_list, ncol = 3, nrow = 2)
print(plots)
dev.off()
# Function to calculate Mahalanobis distance and flag outliers
get_outliers <- function(data, metric_label) {
data_wide <- data %>%
select(Unique_ID, Name, Value) %>%
pivot_wider(names_from = Name, values_from = Value)
# Matrix for distance calculation
data_matrix <- data_wide %>%
select(-Unique_ID)
data_matrix[is.na(data_matrix)] <- 0
# Mahalanobis distance
mahal_dist <- mahalanobis(
x = data_matrix,
center = colMeans(data_matrix),
cov = cov(data_matrix)
)
cutoff <- quantile(mahal_dist, 0.95)
data_wide <- data_wide %>%
mutate(mahal_dist = mahal_dist,
outlier = mahal_dist > cutoff)
return(data_wide)
}
# Apply to both datasets
outliers_vol <- get_outliers(data_vol, "Volume")
outliers_wt <- get_outliers(data_wt, "Weight")
# Plot Mahalanobis distances
ggplot(outliers_vol, aes(x = mahal_dist, fill = outlier)) +
geom_histogram(bins = 30, alpha = 0.7, color = "black") +
geom_vline(xintercept = quantile(outliers_vol$mahal_dist, 0.95),
color = "red", linetype = "dashed", size = 1) +
labs(title = "Mahalanobis Distance (Volume)",
x = "Mahalanobis Distance", y = "Count") +
theme_minimal()
ggplot(outliers_wt, aes(x = mahal_dist, fill = outlier)) +
geom_histogram(bins = 30, alpha = 0.7, color = "black") +
geom_vline(xintercept = quantile(outliers_wt$mahal_dist, 0.95),
color = "red", linetype = "dashed", size = 1) +
labs(title = "Mahalanobis Distance (Weight)",
x = "Mahalanobis Distance", y = "Count") +
theme_minimal()
# Define outliers
vol_outliers <- outliers_vol %>%
filter(outlier == 'TRUE') %>%
pull(Unique_ID)
wt_outliers <- outliers_wt %>%
filter(outlier == 'TRUE') %>%
pull(Unique_ID)
# Remove outliers
vol_filt <- data_vol #%>%
#filter(!Unique_ID %in% vol_outliers)
wt_filt <- data_wt #%>%
#filter(!Unique_ID %in% wt_outliers)
# Convert data_vol to wide format
data_vol_wide <- vol_filt %>%
pivot_wider(
id_cols = c(HAWC_ID, Study, Metric, Unique_ID, Sample),
names_from = Name,
values_from = Value
) %>%
mutate(across(6:ncol(.), ~replace_na(., 0)))
# Convert data_wt to wide format
data_wt_wide <- wt_filt %>%
pivot_wider(
id_cols = c(HAWC_ID, Study, Metric, Unique_ID, Sample),
names_from = Name,
values_from = Value
) %>%
mutate(across(6:ncol(.), ~replace_na(., 0)))
# Function to run PCA and plot results
run_pca_by_class <- function(data_wide, type_label) {
# Run PCA on the numeric part
pca_result <- prcomp(data_wide[, 6:ncol(data_wide)], scale. = TRUE, center = TRUE)
# Extract scores (PC1 and PC2)
pca_scores <- as.data.frame(pca_result$x[, 1:2])
colnames(pca_scores) <- c("PC1", "PC2")
# Add metadata for tracking samples
pca_scores <- cbind(data_wide[, 1:5], pca_scores)
# Scree plot
scree_plot <- fviz_eig(pca_result) +
ggtitle(paste("Scree Plot - PCA (", type_label, ")"))
print(scree_plot)
# Scores plot
scores_plot <- fviz_pca_ind(pca_result,
geom.ind = "point",
pointshape = 21,
pointsize = 2,
fill.ind = data_wide$Sample,
col.ind = "black",
repel = TRUE) +
ggtitle(paste("PCA - Individuals Plot (", type_label, ")"))
print(scores_plot)
return()
}
# Run PCA per Class for volume data
run_pca_by_class(data_vol_wide, type_label = "Volume")
# Run PCA per Class for weight data
run_pca_by_class(data_wt_wide, type_label = "Weight")
