# rename var -> X#
chem_chr = as.character(chem),
chem_num = suppressWarnings(as.integer(str_extract(chem_chr, "\\d+"))),
chem = ifelse(is.na(chem_num), chem_chr, paste0("X", chem_num)),
# High at top, Low at bottom
complexity = factor(complexity, levels = c("high", "med", "low"))
) %>%
group_by(dataset, complexity, chem) %>%
summarise(var_importance_norm = mean(var_importance_norm, na.rm = TRUE), .groups = "drop")
# map dataset names -> 1..10 (in your preferred order, if you have one)
ds_levels <- heat_big %>% distinct(dataset) %>% pull(dataset)
heat_big <- heat_big %>%
mutate(dataset_id = factor(match(dataset, ds_levels),
levels = seq_along(ds_levels),
