# map dataset names -> 1..10 (keeps the current order they appear; change if you want a specific order)
ds_levels <- heat_big %>% distinct(dataset) %>% pull(dataset)
heat_big <- heat_big %>%
mutate(dataset_id = factor(match(dataset, ds_levels),
levels = seq_along(ds_levels),
labels = seq_along(ds_levels)))
# Make wide per complexity, then stack
make_block <- function(df, comp_level, x_levels){
block <- df %>%
filter(complexity == comp_level) %>%
select(chem, dataset_id, var_importance_norm) %>%
pivot_wider(names_from = dataset_id, values_from = var_importance_norm)
mat <- block %>% select(-chem) %>% as.matrix()
rownames(mat) <- block$chem
# enforce X1.. order and include any missing rows
mat <- mat[match(x_levels, rownames(mat)), , drop = FALSE]
mat
}
# choose variable set + order (e.g., X1..X15 if you want exactly 15)
x_levels <- paste0("X", sort(unique(heat_big$chem %>% str_extract("\\d+") %>% as.integer())))
# If you want EXACTLY top 15 variables: uncomment next line
# x_levels <- paste0("X", 1:15)
mat_high <- make_block(heat_big, "high", x_levels)
mat_med  <- make_block(heat_big, "med",  x_levels)
mat_low  <- make_block(heat_big, "low",  x_levels)
mat <- rbind(mat_high, mat_med, mat_low)
# NAs -> 0
mat[is.na(mat)] <- 0
# column names 1..10
colnames(mat) <- as.character(seq_len(ncol(mat)))
# y-axis labels: only X1..Xk repeated per block (no "High/Med/Low" text)
# (pheatmap uses rownames for labels; we keep them as X#)
# Add gaps between blocks:
gaps_row <- c(nrow(mat_high), nrow(mat_high) + nrow(mat_med))
# ----------------------------
# Color scheme with EXACT zero = light grey
# ----------------------------
# Use symmetric breaks centered at 0, and force the middle color to be grey.
# (More breakpoints = smoother gradient.)
n_breaks <- 101
breaks <- seq(-1, 1, length.out = n_breaks)
# Build colors so that the exact midpoint (0) is light grey
mid_idx <- which.min(abs(breaks - 0))
# blue -> grey -> red
cols_low  <- colorRampPalette(c("blue", "lightgrey"))(mid_idx)
cols_high <- colorRampPalette(c("lightgrey", "red"))(n_breaks - mid_idx + 1)
cols <- c(cols_low, cols_high[-1])  # avoid duplicating grey
# ----------------------------
# Plot
# ----------------------------
p <- pheatmap(
mat,
cluster_rows = FALSE,
cluster_cols = FALSE,
border_color = "white",
cellwidth = 20,
cellheight = 12,
gaps_row = gaps_row,
main = "Variable importance (normalized)",
angle_col = 0,
color = cols,
breaks = breaks
)
p
